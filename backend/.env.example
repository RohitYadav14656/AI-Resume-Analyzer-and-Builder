PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/resume_ai
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=your_strong_jwt_secret_here

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# ── Google OAuth ────────────────────────────────────────────────────────────
# Get this from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Email (Nodemailer) ──────────────────────────────────────────────────────
# Gmail example: host=smtp.gmail.com, port=587, user=you@gmail.com, pass=app-password
# Mailtrap example: host=sandbox.smtp.mailtrap.io, port=2525, user=<mailtrap-user>, pass=<mailtrap-pass>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email_here
EMAIL_PASS=your_email_app_password_here
EMAIL_FROM="Resume AI <your_email_here>"

# ── Frontend URL (used to build verification/reset links in emails) ─────────
FRONTEND_URL=http://localhost:5173

